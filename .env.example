# ============================================================
# AI 花卉识别系统 · 配置模板
# 使用方法：复制为 .env 后按需修改。.env 不入版本库。
# 注意：本工作区路径含空格，路径建议用正斜杠写法。
# ============================================================

# ---------- 应用 ----------
APP_NAME=AI 花卉识别系统
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1

# ---------- 安全（生产环境务必替换） ----------
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------- 数据库 ----------
DATABASE_URL=sqlite:///./flowers.db

# ---------- 上传 ----------
UPLOAD_DIR=backend/app/uploads
MAX_UPLOAD_MB=5
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# ---------- 模型 ----------
# 默认使用的模型名，需与 model_metrics.name 一致
DEFAULT_MODEL=vit_b16
WEIGHTS_DIR=ml/outputs/checkpoints
METRICS_JSON=ml/outputs/metrics.json
DEVICE=auto

# ---------- 跨域（开发模式前端地址） ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 花卉百科数据 ----------
FLOWERS_JSON=backend/app/data/flowers.json
